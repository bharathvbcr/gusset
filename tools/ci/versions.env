# Pinned tool versions for CI and `make lint`. Sourced by tools/ci/lint.sh and by
# the workflows; one place to bump, and no `@latest` anywhere.

# No staticcheck release reads Go 1.27.2 export data: `go list -m -versions
# honnef.co/go/tools` tops out at v0.8.1 (checked 2026-10-12), which fails with
# "export data version 5 is greater than maximum supported version 4" on 1.27.2
# and passes on 1.27.1 (run 37865049259 versus 37944107330). Only the
# staticcheck step runs on STATICCHECK_GO; every other step runs on the Go the
# job installed, so govulncheck still sees the newest standard library. Move
# STATICCHECK_GO forward, together with STATICCHECK_VERSION, when upstream
# releases a version that reads the newer export data.
STATICCHECK_VERSION=v0.8.1
STATICCHECK_GO=go1.27.1

GOVULNCHECK_VERSION=v1.9.0
CARGO_DENY_VERSION=0.20.2

# golang.org/x/perf has no tagged releases; this is the pseudo-version the
# committed README figures were generated with.
BENCHSTAT_VERSION=v0.0.0-20260908200009-22c9c6c9d4da
