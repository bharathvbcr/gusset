# Pinned tool versions for CI and `make lint`. Sourced by tools/ci/lint.sh and by
# the workflows; one place to bump, and no `@latest` anywhere.

# v0.8.2 reads Go 1.27.2 export data. v0.8.1 failed on it with "export data
# version 5 is greater than maximum supported version 4" (verified 2026-10-12 by
# running both against go1.27.2). Staticcheck therefore runs on the same
# floating 1.27.x toolchain as every other step and needs no Go patch pin. If a
# later Go release breaks it again, bump this version rather than pinning the
# compiler.
#
# Re-check this pin on every Go patch release: setup-go's '1.27.x' floats, so a
# new patch can change the export data format under a pinned staticcheck (as
# 1.27.2 did to v0.8.1) with no commit here to blame. The lint log prints the
# Go and staticcheck versions it ran with.
STATICCHECK_VERSION=v0.8.2

GOVULNCHECK_VERSION=v1.9.0
CARGO_DENY_VERSION=0.20.2
CARGO_FUZZ_VERSION=0.13.2

# golang.org/x/perf has no tagged releases; this is the pseudo-version the
# committed README figures were generated with.
BENCHSTAT_VERSION=v0.0.0-20260908200009-22c9c6c9d4da

# rustup-init for the two musl jobs (r14-musl, musl), which run in an Alpine
# container and install Rust with it. Alpine's own `rustup` package is not used:
# its rustup-init is a build this repo never checked. The checksum is the one
# static.rust-lang.org publishes beside the binary
#   https://static.rust-lang.org/rustup/archive/<version>/x86_64-unknown-linux-musl/rustup-init.sha256
# and was recomputed from the downloaded file (verified 2026-10-24 on 1.29.2).
# To bump: set the new version, fetch that .sha256, and put its hash here; both
# jobs fail at `sha256sum -c` until the two agree.
RUSTUP_VERSION=1.29.2
RUSTUP_INIT_SHA256_X86_64_MUSL=2ba97d668c06dc4b1884f2a3fa6f4cf14b9bd0c1db379af7e4f87a705ff19edd
