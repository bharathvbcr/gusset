# Pinned tool versions for CI and `make lint`. Sourced by tools/ci/lint.sh and by
# the workflows; one place to bump, and no `@latest` anywhere.

# v0.8.2 reads Go 1.27.2 export data. v0.8.1 failed on it with "export data
# version 5 is greater than maximum supported version 4" (verified 2026-10-12 by
# running both against go1.27.2). Staticcheck therefore runs on the same
# floating 1.27.x toolchain as every other step and needs no Go patch pin. If a
# later Go release breaks it again, bump this version rather than pinning the
# compiler.
STATICCHECK_VERSION=v0.8.2

GOVULNCHECK_VERSION=v1.9.0
CARGO_DENY_VERSION=0.20.2
CARGO_FUZZ_VERSION=0.13.2

# golang.org/x/perf has no tagged releases; this is the pseudo-version the
# committed README figures were generated with.
BENCHSTAT_VERSION=v0.0.0-20260908200009-22c9c6c9d4da
