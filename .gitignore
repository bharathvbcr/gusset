target/
*.a
*.test
bench/results/*.tmp

# macOS
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes

# Local agent/account state (also excluded per-machine; listed here so clones agree)
.claude-account
.claude/settings.local.json
.cursor/hooks/state/

# Editors and IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Go test and profiling output
*.out
*.prof
*.pprof
*.exe
cover.html
coverage.txt
*.cov

# Rust coverage and profiler output
*.profraw
*.profdata
cargo-timing*.html
perf.data*

# Native build artifacts
*.o
*.so
*.dylib
*.dll
*.rlib
*.rmeta

# Environment and secrets
.env
.env.*
!.env.example

# Logs and merge leftovers
*.log
*.orig
*.rej

# DevCouncil (ignore state, caches, databases; track config.yaml)
.devcouncil/*
!.devcouncil/
!.devcouncil/config.yaml

# GitPulse (agent worktrees and task state)
.gitpulse/

# bench/record.sh holds this while a recording runs and removes it on exit. The
# stage and claim directories are the private directory a lock is built in and a
# claim a takeover of a dead recorder's lock holds; both are removed on every exit it can
# handle, and these patterns cover the one it cannot (SIGKILL).
bench/results/.record.lock/
bench/results/.record.lock.stage.*/
bench/results/.record.lock.claim/

# bench/record_test.sh's scratch directories; it removes them on every exit.
bench/.probe/

# bench/r14/run.sh stamps the linked archives' hash here before every link.
bench/r14/host/zz_archives.go

# DevCouncil local state
!/.devcouncil/

# go generate ./internal/ffi stamps the local archive hash here, through a
# dot-named temporary file; the tracked stub internal/ffi/archive_hash.go explains.
internal/ffi/zz_archive_hash.go
internal/ffi/.zz_archive_hash.go.*
