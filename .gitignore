# DevCouncil (ignore state, caches, databases; track config.yaml)
.devcouncil/*
!.devcouncil/
!.devcouncil/config.yaml

# GitPulse (agent worktrees and task state)
.gitpulse/

# bench/record.sh holds this while a recording runs and removes it on exit.
bench/results/.record.lock/

# bench/r14/run.sh stamps the linked archives' hash here before every link.
bench/r14/host/zz_archives.go
